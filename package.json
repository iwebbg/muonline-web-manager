{
  "name": "muonline-web-manager",
  "version": "0.1.0",
  "description": "Windows WSL2 control panel for MuOnline Web",
  "author": "InterWeb",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:node && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:node": "node --test --test-isolation=none tests/*.test.js",
    "test:python": "python -m unittest discover -s tests -p test_*.py",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "release:web": "python3 scripts/package-release.py",
    "test:ui": "node scripts/run-electron-smoke.js",
    "test:contract": "python3 scripts/test-laravel-contract.py",
    "test:sql": "python3 scripts/test-sql-backup.py",
    "test:sql-troubleshooting": "python3 scripts/test-sql-troubleshooting.py",
    "validate:trust": "node scripts/validate-trust.js",
    "test:release": "python3 scripts/test-runtime-release.py"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "bg.interweb.muonline.manager",
    "productName": "MuOnline Web Manager",
    "icon": "icon.png",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "icon.png",
        "to": "icon.png"
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "build/trust.json",
        "to": "trust.json"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "MuOnline-Web-Manager-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "bg_BG"
      ],
      "displayLanguageSelector": true
    }
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
